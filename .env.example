# Copia este archivo como .env para desarrollo local.
# Los valores reales se configuran en Vercel > Settings > Environment Variables.
# Nunca subas el archivo .env al repositorio.

# Conexion a Postgres de Supabase. Usa el pooler en modo transaccion (puerto 6543),
# no la conexion directa: en serverless se abren y cierran conexiones constantemente.
DATABASE_URL=postgresql://usuario:password@aws-0-region.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_llave_publica

# Cadena aleatoria larga para firmar las sesiones de propietario.
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
